{
  "hosting": {
    "site": "joseacuno-dev",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".agents/**",
      ".github/**",
      ".firebase/**",
      "**/node_modules/**",
      "**/*.md",
      "package*.json",
      "*.log",
      "others/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
